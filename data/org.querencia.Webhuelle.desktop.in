[Desktop Entry]
# Querencia Webhülle (bis 0.1.1 „Querencia Nachrichten“). Desktop-ID =
# GApplication-ID org.querencia.Webhuelle, damit labwc und die Fensterliste
# das Fenster dieser Datei zuordnen.
# Vorlage: Name, GenericName, Comment und Keywords sind englisch; die
# Übersetzungen (Name[de]= …) setzt `werkzeug/i18n.py desktop` aus po/*.po
# ein (entspricht msgfmt --desktop). Erzeugt: org.querencia.Webhuelle.desktop.
# Menü Internet (Network). Eigenes Symbol org.querencia.Webhuelle (hicolor,
# data/icons/); die Marke des Dienstes steht nur beschreibend in Comment und
# Keywords, nie im Namen oder Symbol.
Type=Application
Version=1.5
Name=Web Wrapper
GenericName=Wrapper for WhatsApp Web
Comment=Use WhatsApp Web in its own window
Exec=querencia-webhuelle
TryExec=querencia-webhuelle
Icon=org.querencia.Webhuelle
Terminal=false
Categories=GTK;Network;InstantMessaging;Chat;
Keywords=WhatsApp;Chat;Messenger;Messages;Wrapper;
StartupNotify=true
StartupWMClass=org.querencia.Webhuelle
